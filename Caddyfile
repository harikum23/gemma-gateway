{
    admin off
    auto_https off
}

# On-host consumers reach gateway directly on :8080 (no Caddy hop).
# Caddy only fronts TLS on :8443 for off-host / LAN consumers.

:8443 {
    encode gzip

    @health path /v1/health
    handle @health {
        reverse_proxy gateway:8080
    }

    handle /v1/* {
        reverse_proxy gateway:8080 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            transport http {
                dial_timeout 5s
                read_timeout 120s
                write_timeout 120s
            }
        }
    }

    handle {
        respond "gemma-gateway" 200
    }

    log {
        output stdout
        format console
        level INFO
    }
}
