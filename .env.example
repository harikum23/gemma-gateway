# Copy to .env (gitignored) and edit as needed.

# Bootstrap API key. If set, gateway creates this key on first boot; clients use it as Bearer token.
# If unset, gateway auto-generates a random key and logs it once at startup.
GATEWAY_BOOTSTRAP_API_KEY=

# Engine
GATEWAY_ENGINE_URL=http://host.docker.internal:11434
GATEWAY_ENGINE_TYPE=ollama
GATEWAY_DEFAULT_MODEL=gemma4:e4b
GATEWAY_DEFAULT_EMBED_MODEL=nomic-embed-text

# Admission queue / rate limit
GATEWAY_ADMISSION_MAX_DEPTH=32
GATEWAY_ADMISSION_MAX_WAIT_MS=60000
GATEWAY_DEFAULT_RPS_LIMIT=10
GATEWAY_DEFAULT_TPM_LIMIT=60000

# Observability
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_PROMPTS=false
